{
  "name": "ariad-breast-toxicity-companion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm content:build:preview && pnpm --filter @ariad/web dev",
    "build": "pnpm content:build && pnpm typecheck && pnpm --filter @ariad/web build",
    "build:preview": "ALLOW_DRAFT_CONTENT=true NEXT_PUBLIC_DEMO_MODE=true pnpm content:build && pnpm typecheck && pnpm --filter @ariad/web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/accessibility",
    "content:validate": "tsx scripts/content-cli.ts validate",
    "content:build": "tsx scripts/content-cli.ts build",
    "content:build:preview": "ALLOW_DRAFT_CONTENT=true tsx scripts/content-cli.ts build",
    "content:report": "tsx scripts/content-cli.ts report",
    "safety:scan": "tsx scripts/safety-scan.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
