# Server-only OpenAI configuration. Never expose this key to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ENABLE_GPT56=true

# Ariad Build Week preview. Draft clinical content is never enabled silently.
NEXT_PUBLIC_DEMO_MODE=true
ALLOW_DRAFT_CONTENT=false
CONTENT_RELEASE_ID=build-week-preview-2026-07-18

# Optional bounded-runtime controls.
AI_MAX_INPUT_CHARS=500
AI_REQUEST_TIMEOUT_MS=12000

